---
import MainLayout from '../layouts/MainLayout.astro';
import { Content as AboutPage } from '../content/about.md';
import SocialIcon from '../components/SocialIcon.astro';
import siteConfig from '../../site.config.mjs';

const profileImage = siteConfig.profileImage;
const socialLinks = siteConfig.socialLinks;
const base = import.meta.env.BASE_URL;


const awards = [
	{
		image: 'nights_out_by_deerarylide.jpg',
		caption: 'Nights out - Daily Deviation Award',
		url: 'https://www.deviantart.com/deerarylide/art/Nights-Out-531616303',
		quote: 'There\'s something incredibly intriguing and poignant about Nights Out by Arylide in which darkness and light contrast both literally and metaphorically in ways the viewer is open to interpret',
		author: 'Devitant Art Staff',
	},
	{
		image: 'where_i_live_by_deerarylide.jpg',
		caption: 'Where I live - Daily Deviation Award',
		url: 'https://www.deviantart.com/deerarylide/art/Where-i-live-434828931',
		quote: 'This is just one of the many soft, delicate and beautiful floral photographs from her gallery',
		author: 'Deviant Art Staff',
	},
];
---

<MainLayout>
	<section class="pt-32 pb-20">
		<div class="container-custom">
			<div class="max-w-2xl mx-auto text-center mb-16">
				<h1 class="text-4xl md:text-5xl font-bold mb-4">About</h1>
			</div>

			<!-- Photo + texte -->
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
				<div>
					<img
						src=`${base}/images/${profileImage}`
						alt="Profile image"
						class="w-full h-auto rounded-lg shadow-lg border-8 my-4 border-white md:p-4"
						width="720"
						height="720"
					/>
				</div>

				<div class="prose text-gray-700 mb-6">
					<AboutPage />
				</div>
			</div>

			<!-- Awards & distinctions -->
			<div class="mt-24">
				<h2 class="text-3xl md:text-4xl font-bold text-center mb-20">Awards &amp; distinctions</h2>
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-x-[100px] gap-y-16 max-w-2xl mx-auto">
			{awards.map((award) => (
				<div>
					<a
						href={award.url}
						target="_blank"
						rel="noopener noreferrer"
						class="group block"
					>
						<figure>
							<img
								src={`${base}/images/awards/${award.image}`}
								alt={award.caption}
								class="w-full aspect-square object-cover rounded-lg shadow-md transition-shadow duration-200 group-hover:shadow-xl"
								loading="lazy"
							/>
							<figcaption class="mt-3 text-center text-gray-600 group-hover:text-gray-900 group-hover:underline transition-colors">
								{award.caption}
							</figcaption>
						</figure>
					</a>

					{award.quote && (
						<blockquote class="mt-8">
							<div class="relative px-10 py-4">
								<span
									aria-hidden="true"
									class="absolute left-0 -top-2 font-serif text-6xl leading-none text-gray-300 select-none"
								>
									“
								</span>

								<p class="text-center font-serif text-lg italic leading-relaxed text-gray-700">
									{award.quote}
								</p>

								<span
									aria-hidden="true"
									class="absolute right-0 -bottom-6 font-serif text-6xl leading-none text-gray-300 select-none"
								>
									”
								</span>
							</div>

							{award.author && (
								<footer class="mt-6 text-center text-sm tracking-wide text-gray-500">
									— {award.author}
								</footer>
							)}
						</blockquote>
					)}
				</div>
			))}
			</div>	
			</div>

			<!-- Réseaux sociaux -->
			<div class="mt-20 pt-12 border-t border-gray-100 flex justify-center space-x-6">
				{socialLinks.map((socialLink) => <SocialIcon socialLink={socialLink} />)}
			</div>
		</div>
	</section>
</MainLayout>
