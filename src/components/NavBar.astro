---
import siteConfig from '../../site.config.mjs';

const title = siteConfig.title;

const base = import.meta.env.BASE_URL;
const isHome = Astro.url.pathname.replace(/\/$/, '') === base.replace(/\/$/, '');
const menuItems = [
	{ name: 'HOME', link: `${base}` },
	{ name: 'GALLERY', link: `${base}/collections` },
	{ name: 'ABOUT', link: `${base}/about` },
];
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400..700&display=swap"
	rel="stylesheet"
/>

<nav
	x-data={`{
		isOpen: false,
		scrolled: false,
		isHome: ${isHome},
		get lightMode() { return this.isHome && !this.scrolled; }
	}`}
	@scroll.window="scrolled = window.scrollY > 50"
	class="fixed top-0 left-0 w-full z-50 transition-all duration-300"
	:class="scrolled ? 'py-3 bg-white shadow-sm' : 'py-5 bg-transparent'"
>
	<div class="container mx-auto flex justify-start items-center gap-10">
		<a href={base}
			id="logo"
			class="text-4xl md:text-6xl font-normal tracking-tight"
			:class="lightMode ? 'md:text-white' : ''">
			{title}
		</a>

		<!-- Desktop Menu -->
		<div class="hidden md:flex space-x-8">
			{
				menuItems.map((item) => (
					<a
						href={item.link}
						class="nav-link"
						:class="lightMode ? 'md:text-white md:hover:text-white/70' : ''"
					>
						{item.name}
					</a>
				))
			}
		</div>

		<!-- Mobile Menu Button -->
		<button
			@click="isOpen = !isOpen"
			class="md:hidden ml-auto focus:outline-none"
			:class="lightMode ? 'md:text-white text-gray-800' : 'text-gray-800'"
		>
			<svg x-show="!isOpen" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M4 6h16M4 12h16M4 18h16"></path>
			</svg>
			<svg x-show="isOpen" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M6 18L18 6M6 6l12 12"></path>
			</svg>
		</button>
	</div>

	<!-- Mobile Menu -->
	<div x-show="isOpen" class="md:hidden absolute top-full left-0 w-full bg-white shadow-md">
		<div class="flex flex-col py-4 px-6 space-y-4">
			{
				menuItems.map((item) => (
					<a href={item.link} class="text-lg" @click="isOpen = false">
						{item.name}
					</a>
				))
			}
		</div>
	</div>
</nav>
