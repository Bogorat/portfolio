---
import { Image } from 'astro:assets';
import { featuredCollectionId, getImages } from '../data/imageStore';
import siteConfig from '../../site.config.mjs';

const owner = siteConfig.owner;
const images = await getImages({ collection: featuredCollectionId });
---

<div
	x-data={`{ current: 0, slides: ${images.length} }`}
	x-init="setInterval(() => current = (current + 1) % slides, 5000)"
	class="relative w-full h-[70vh] md:h-screen overflow-hidden bg-white"
>
	{images.map((image, index) => (
		<div
			x-show={`current === ${index}`}
			x-transition:enter="transition ease-out duration-700"
			x-transition:enter-start="opacity-0"
			x-transition:enter-end="opacity-100"
			x-transition:leave="transition ease-in duration-500"
			x-transition:leave-start="opacity-100"
			x-transition:leave-end="opacity-0"
			class="w-full h-full flex items-center justify-center md:absolute md:inset-0"
		>
			<Image
				src={image.src}
				alt={image.title}
				quality={90}
				format="webp"
				width={image.src.width}
				height={image.src.height}
				class="max-w-full max-h-full object-contain p-6 md:w-full md:h-full md:max-w-none md:max-h-none md:object-cover md:p-0"
			/>
			<div class="hidden md:block absolute inset-0 bg-black/30" />
		</div>
	))}

	<!-- Titre en overlay, desktop uniquement -->
	<div class="hidden md:flex absolute inset-0 flex-col items-center justify-center text-center z-10 px-4">
		<!-- <h1 class="text-4xl md:text-6xl font-bold text-white drop-shadow-lg hero-title">{owner} Photography</h1> -->
		<p class="mt-4 text-lg text-white/90 drop-shadow">A place to showcase my photography</p>
	</div>

	<button @click="current = (current - 1 + slides) % slides" class="absolute left-4 top-1/2 -translate-y-1/2 z-20 text-white/80 hover:text-white text-4xl md:text-white/80" aria-label="Photo précédente">‹</button>
	<button @click="current = (current + 1) % slides" class="absolute right-4 top-1/2 -translate-y-1/2 z-20 text-white/80 hover:text-white text-4xl md:text-white/80" aria-label="Photo suivante">›</button>

	<div class="absolute bottom-4 md:bottom-8 left-0 right-0 flex justify-center gap-2 z-20">
		{images.map((_, index) => (
			<button
				@click={`current = ${index}`}
				:class={`current === ${index} ? 'bg-gray-800 md:bg-white w-6' : 'bg-gray-400 md:bg-white/50'`}
				class="h-2 rounded-full w-2 transition-all"
				aria-label={`Aller à la photo ${index + 1}`}
			/>
		))}
	</div>
</div>

<!-- Titre sous l'image, mobile uniquement -->
<div class="md:hidden text-center px-4 py-8 bg-white">
	<!-- <h1 class="text-3xl font-bold text-gray-900 hero-title">{owner} Photography</h1> -->
	<p class="mt-3 text-base text-gray-600">A place to showcase my photography</p>
</div>
